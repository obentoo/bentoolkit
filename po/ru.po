msgid_plural "  Discard that work and remove these %d package(s)?"
msgstr[0] "  Отменить эту работу и удалить эти %d пакет?"
msgstr[1] "  Отменить эту работу и удалить эти %d пакета?"
msgstr[2] "  Отменить эту работу и удалить эти %d пакетов?"

#: cmd/bentoo/overlay_prune.go
msgid "Prune Result"
msgstr "Результат очистки"

#: cmd/bentoo/overlay_prune.go
msgid "  %s removed (%d file(s))\n"
msgid_plural "  %s removed (%d file(s))\n"
msgstr[0] "  %s удалено (%d файл)\n"
msgstr[1] "  %s удалено (%d файла)\n"
msgstr[2] "  %s удалено (%d файлов)\n"

#: cmd/bentoo/overlay_prune.go
msgid "  %s NOT removed: %v\n"
msgstr "  %s НЕ удалено: %v\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Removed %d package director(ies) from the overlay.\n"
msgid_plural "  Removed %d package director(ies) from the overlay.\n"
msgstr[0] "  Удалены %d каталога пакетов из оверлея.\n"
msgstr[1] "  Удалены %d каталога пакетов из оверлея.\n"
msgstr[2] "  Удалено %d каталогов пакетов из оверлея.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  %d removal(s) failed and are listed above; those packages are still in the overlay, registry entries and all.\n"
msgid_plural "  %d removal(s) failed and are listed above; those packages are still in the overlay, registry entries and all.\n"
msgstr[0] "  %d операция удаления не выполнена и указана выше; эти пакеты по-прежнему находятся в оверлее, включая записи реестра и всё остальное.\n"
msgstr[1] "  %d удаления не выполнены и перечислены выше; эти пакеты по-прежнему находятся в оверлее, вместе с записями реестра и прочим.\n"
msgstr[2] "  %d операций удаления не выполнены и перечислены выше; эти пакеты по-прежнему находятся в оверлее, записи реестра и всё остальное.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  %d planned removal(s) were declined at the prompt and left exactly as they were.\n"
msgid_plural "  %d planned removal(s) were declined at the prompt and left exactly as they were.\n"
msgstr[0] "  %d запланированное удаление было отклонено при запросе и оставлено в точности в прежнем виде.\n"
msgstr[1] "  %d запланированных удаления были отклонены при запросе и оставлены в точности такими, какими они были.\n"
msgstr[2] "  %d запланированных удалений были отклонены при запросе подтверждения и оставлены в точности такими, какими они были.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  %d planned removal(s) had no confirmation and were not carried out — see the reason above. This run exits non-zero because of them.\n"
msgid_plural "  %d planned removal(s) had no confirmation and were not carried out — see the reason above. This run exits non-zero because of them.\n"
msgstr[0] "  %d запланированное удаление не было подтверждено и не было выполнено — см. причину выше. Из-за них этот запуск завершается с ненулевым кодом.\n"
msgstr[1] "  %d запланированных удаления не были подтверждены и не были выполнены — см. причину выше. Из-за них этот запуск завершается с ненулевым кодом.\n"
msgstr[2] "  %d запланированных удалений не были подтверждены и не были выполнены — см. причину выше. Из-за них этот запуск завершается с ненулевым кодом.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing was removed: no confirmation covered the %d planned removal(s) — see the reason above.\n"
msgid_plural "  Nothing was removed: no confirmation covered the %d planned removal(s) — see the reason above.\n"
msgstr[0] "  Ничего не было удалено: ни одно из %d запланированного удаления не было подтверждено — см. причину выше.\n"
msgstr[1] "  Ничего не было удалено: ни одно подтверждение не охватывало %d запланированных удаления — см. причину выше.\n"
msgstr[2] "  Ничего не было удалено: ни одно из %d запланированных удалений не было подтверждено — см. причину выше.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing was removed: the confirmation was declined. The overlay and .autoupdate/packages.toml are exactly as they were."
msgstr "  Ничего не было удалено: подтверждение было отклонено. Overlay и .autoupdate/packages.toml остались точно такими же, какими были."

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing was removed."
msgstr "  Ничего не было удалено."

#: cmd/bentoo/overlay_prune.go
msgid "  The package directories are gone and the registry still lists them; delete those entries by hand. An entry whose package directory no longer exists promises an endpoint for something that is not there, and the next --check disables it without saying why."
msgstr "  Каталоги пакетов отсутствуют, но они всё ещё указаны в реестре; удалите эти записи вручную. Запись, каталог пакета которой больше не существует, обещает конечную точку для чего-то, чего нет, и следующая команда --check отключает её, не объясняя причину."

#: cmd/bentoo/overlay_prune.go
msgid "  Deleted the .autoupdate/packages.toml entries of %d removed package(s).\n"
msgid_plural "  Deleted the .autoupdate/packages.toml entries of %d removed package(s).\n"
msgstr[0] "  Удалены записи в .autoupdate/packages.toml для %d удалённого пакета.\n"
msgstr[1] "  Удалены записи в .autoupdate/packages.toml для %d удалённых пакетов.\n"
msgstr[2] "  Удалены записи в .autoupdate/packages.toml для %d удалённых пакетов.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  The package directories are gone and the registry still lists them as enabled; the next --check disables them on its own."
msgstr "  Каталоги пакетов удалены, а реестр всё ещё считает их включёнными; следующий --check отключит их сам."

#: cmd/bentoo/overlay_prune.go
msgid "  Disabled the .autoupdate/packages.toml entries of %d removed package(s) (enabled = false, disabled_by = \"auto\").\n"
msgid_plural "  Disabled the .autoupdate/packages.toml entries of %d removed package(s) (enabled = false, disabled_by = \"auto\").\n"
msgstr[0] "  Отключены записи .autoupdate/packages.toml для %d удалённого пакета (enabled = false, disabled_by = \"auto\").\n"
msgstr[1] "  Отключены записи .autoupdate/packages.toml для %d удалённых пакетов (enabled = false, disabled_by = \"auto\").\n"
msgstr[2] "  Отключены записи .autoupdate/packages.toml для %d удалённых пакетов (enabled = false, disabled_by = \"auto\").\n"

#: cmd/bentoo/overlay_prune.go
msgid "Identical to ::gentoo — our copy holds nothing of ours"
msgstr "Идентично ::gentoo — в нашей копии нет ничего нашего"

#: cmd/bentoo/overlay_prune.go
msgid "Diverging — something of ours is in these"
msgstr "Расхождение — в них есть что-то наше"

#: cmd/bentoo/overlay_prune.go
msgid "    %s — would be removed\n"
msgstr "    %s — будет удалён\n"

#: cmd/bentoo/overlay_prune.go
msgid "    %s — kept on this run\n"
msgstr "    %s — сохранено в этом запуске\n"

#: cmd/bentoo/overlay_prune.go
msgid "      why:      %s\n"
msgstr "      причина:  %s\n"

#: cmd/bentoo/overlay_prune.go
msgid "      versions: %s\n"
msgstr "      версии: %s\n"

#: cmd/bentoo/overlay_prune.go
msgid "      files (%d):\n"
msgstr "      файлы (%d):\n"

#: cmd/bentoo/overlay_prune.go
msgid "      registry: no entry tracks this package"
msgstr "      registry: ни одна запись не отслеживает этот пакет"

#: cmd/bentoo/overlay_prune.go
msgid "      registry: %d entr(ies) kept by --keep-registry: %s\n"
msgid_plural "      registry: %d entr(ies) kept by --keep-registry: %s\n"
msgstr[0] "      registry: %d запись сохранена с помощью --keep-registry: %s\n"
msgstr[1] "      registry: %d записи сохранены с помощью --keep-registry: %s\n"
msgstr[2] "      registry: %d записей сохранены с помощью --keep-registry: %s\n"

#: cmd/bentoo/overlay_prune.go
msgid "      registry entries (%d):\n"
msgstr "      записи реестра (%d):\n"

#: cmd/bentoo/overlay_prune.go
msgid "      registry entries to disable (%d):\n"
msgstr "      записи реестра к отключению (%d):\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Refused — no flag on this command removes these (%d):\n"
msgstr "  Отклонено — ни один флаг этой команды не удаляет следующие элементы (%d):\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing qualified for removal: %d package(s) were examined and none of them may be removed.\n"
msgid_plural "  Nothing qualified for removal: %d package(s) were examined and none of them may be removed.\n"
msgstr[0] "  Ничто не подлежит удалению: было проверено %d пакетов, и ни один из них нельзя удалить.\n"
msgstr[1] "  Ничего не подлежит удалению: было проверено %d пакета, и ни один из них нельзя удалить.\n"
msgstr[2] "  Ничто не подлежит удалению: было проверено %d пакетов, и ни один из них нельзя удалить.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  %d of them diverge from ::gentoo; --include-patched would consider them, discarding that work.\n"
msgstr "  %d из них отличаются от ::gentoo; --include-patched будет учитывать их, игнорируя эту работу.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing was examined: the %s provider exposes no local ::gentoo tree, so none of the %d package(s) in scope could be compared.\n"
msgid_plural "  Nothing was examined: the %s provider exposes no local ::gentoo tree, so none of the %d package(s) in scope could be compared.\n"
msgstr[0] "  Ничего не было проверено: провайдер %s не предоставляет локальное дерево ::gentoo, поэтому ни один из %d пакета в области действия не подлежал сравнению.\n"
msgstr[1] "  Ничего не было проверено: поставщик %s не предоставляет локальное дерево ::gentoo, поэтому ни один из %d пакетов в области действия не подлежал сравнению.\n"
msgstr[2] "  Ничего не было проверено: провайдер %s не предоставляет локальное дерево ::gentoo, поэтому ни один из %d пакетов в области действия не удалось сравнить.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Every package is refused: no local ::gentoo tree; re-run with --clone or a local provider."
msgstr "  Все пакеты отклоняются: отсутствует локальное дерево ::gentoo; запустите команду повторно с флагом --clone или с использованием локального провайдера."

#: cmd/bentoo/overlay_prune.go
msgid "  Content is the only evidence that may authorise a removal, and an API can supply it only at one rate-limited request per package."
msgstr "  Содержимое — единственное доказательство, которое может служить основанием для удаления, и API может предоставить его только в ответ на один запрос с ограничением частоты на пакет."

#: cmd/bentoo/overlay_prune.go
msgid "  Point bentoo at an on-disk ::gentoo in ~/.config/bentoo/config.yaml:"
msgstr "  Укажите bentoo на находящийся на диске ::gentoo в ~/.config/bentoo/config.yaml:"

#: cmd/bentoo/overlay_prune.go
msgid "  Nothing was examined: the autoupdate registry could not be read, so none of the %d package(s) in scope has a known divergence state.\n"
msgid_plural "  Nothing was examined: the autoupdate registry could not be read, so none of the %d package(s) in scope has a known divergence state.\n"
msgstr[0] "  Ничего не было проверено: реестр автообновлений не удалось прочитать, поэтому ни для одного из %d пакета в области действия не известно состояние расхождения.\n"
msgstr[1] "  Ничего не было проверено: реестр автоматического обновления не удалось прочитать, поэтому ни один из %d пакетов в области действия не имеет известного состояния расхождения.\n"
msgstr[2] "  Ничего не было проверено: реестр автоматического обновления не удалось прочитать, поэтому ни для одного из %d пакетов в области действия не известно состояние расхождения.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  Every package is refused: %v.\n"
msgstr "  Все пакеты отклонены: %v.\n"

#: cmd/bentoo/overlay_prune.go
msgid "  The registry is where 'patched' is declared, and a package whose declaration cannot be read must not be removed on the assumption that it has none."
msgstr "  В реестре объявляется статус «patched», и пакет, декларацию которого невозможно прочитать, нельзя удалять, исходя из предположения, что у него нет такого статуса."

#: cmd/bentoo/overlay_prune.go
msgid "  Repair or restore .autoupdate/packages.toml in the overlay, then re-run."
msgstr "  Восстановите или верните в исходное состояние файл .autoupdate/packages.toml в оверлее, а затем запустите команду повторно."

#: cmd/bentoo/overlay_pull.go
msgid "Pull upstream changes into the overlay"
msgstr "Получить изменения из upstream в оверлей"

#: cmd/bentoo/overlay_pull.go
msgid ""
"Fetch the configured remote and integrate the current branch's upstream.\n"
"\n"
"By default the integration is fast-forward only: if the overlay has diverged\n"
"from its upstream, the pull refuses rather than writing a merge commit. Use\n"
"--rebase to replay local commits on top of the upstream, or --merge to accept\n"
"a merge commit."
msgstr ""
"Выполняет fetch из настроенного удалённого репозитория и интегрирует upstream текущей ветки.\n"
"\n"
"По умолчанию интеграция выполняется только методом fast-forward: если оверлей разошелся\n"
"от своего апстрима, команда pull отклоняет операцию вместо того, чтобы создать коммит слияния. Используйте\n"
"--rebase, чтобы повторно применить локальные коммиты поверх апстрима, или --merge, чтобы принять\n"
"коммит слияния."

#: cmd/bentoo/overlay_pull.go
msgid "Replay local commits on top of the upstream"
msgstr "Повторно применить локальные коммиты поверх апстрима"

#: cmd/bentoo/overlay_pull.go
msgid "Merge the upstream, allowing a merge commit"
msgstr "Выполнить слияние с веткой upstream, разрешив коммит слияния"

#: cmd/bentoo/overlay_pull.go
msgid "Show what would be pulled without integrating"
msgstr "Показать, что было бы извлечено без интеграции"

#: cmd/bentoo/overlay_pull.go
msgid "Resolve conflicts manually, then run 'git add' and 'git rebase --continue'"
msgstr "Устраните конфликты вручную, затем выполните команды \"git add\" и \"git rebase --continue\""

#: cmd/bentoo/overlay_pull.go
msgid "Or abort the rebase with 'git rebase --abort'"
msgstr "Или прервите перебазирование с помощью 'git rebase --abort'"

#: cmd/bentoo/overlay_pull.go
msgid "Resolve conflicts manually, then run 'git add' and 'git commit'"
msgstr "Устраните конфликты вручную, затем выполните команды \"git add\" и \"git commit\""

#: cmd/bentoo/overlay_pull.go
msgid "Or abort the merge with 'git merge --abort'"
msgstr "Или прервите слияние с помощью «git merge --abort»"

