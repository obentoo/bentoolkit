msgstr "%s уже находится в режиме охлаждения\n"

#: cmd/bentoo/overlay_cooldown.go
msgid "masked  %s (eligible %s)\n"
msgstr "замаскировано  %s (подходит %s)\n"

#: cmd/bentoo/overlay_cooldown.go
