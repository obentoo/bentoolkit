msgstr "Вывести массив JSON, содержащий {package, version, since, eligible, group, origin, installed}"

#: cmd/bentoo/overlay_cooldown.go
msgid "system root whose var/db/pkg answers `installed`"
msgstr "корень системы, в котором var/db/pkg отвечает `installed`"

#: cmd/bentoo/overlay_cooldown.go
msgid "PACKAGE\tVERSION\tSINCE\tELIGIBLE\tGROUP\tORIGIN\tINSTALLED"
msgstr "PACKAGE\tVERSION\tSINCE\tELIGIBLE\tGROUP\tORIGIN\tINSTALLED"

#: cmd/bentoo/overlay_cooldown.go
msgid "Release a version and every older one of the package (a whole group for a grouped package)"
msgstr "Выпустить версию и все более старые версии пакета (целую группу для сгруппированного пакета)"

#: cmd/bentoo/overlay_cooldown.go
