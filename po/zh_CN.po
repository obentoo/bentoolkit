msgstr "API 提供商的身份验证令牌"

#: cmd/bentoo/overlay_compare.go
msgid "Show only outdated packages (Bentoo < Gentoo)"
msgstr "仅显示过时的软件包（Bentoo < Gentoo）"

#: cmd/bentoo/overlay_compare.go
msgid "Show only redundant packages (removal candidates)"
msgstr "仅显示冗余软件包（待移除候选）"

#: cmd/bentoo/overlay_compare.go
