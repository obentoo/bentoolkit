msgstr "打印一个包含 {package, version, since, eligible, group, origin, installed} 的 JSON 数组"

#: cmd/bentoo/overlay_cooldown.go
msgid "system root whose var/db/pkg answers `installed`"
msgstr "其 var/db/pkg 回答为 `installed` 的系统根目录"

#: cmd/bentoo/overlay_cooldown.go
msgid "PACKAGE\tVERSION\tSINCE\tELIGIBLE\tGROUP\tORIGIN\tINSTALLED"
