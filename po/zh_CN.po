msgstr "pkgdev 使用的 Distfiles 目录（默认：运行后删除的临时目录）"

#: cmd/bentoo/overlay_manifest.go
msgid "Maximum parallel pkgdev workers"
msgstr "最大并行 pkgdev 工作线程数"

#: cmd/bentoo/overlay_manifest.go
