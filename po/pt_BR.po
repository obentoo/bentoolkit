msgid "Notice type: security, release, news or announcement"
msgstr "Tipo de aviso: security, release, news ou announcement"

#: cmd/bentoo/notice.go
msgid "Severity: info, warning or critical"
msgstr "Gravidade: info, warning ou critical"

#: cmd/bentoo/notice.go
msgid "Title, at most 50 characters"
msgstr "Título, no máximo 50 caracteres"

#: cmd/bentoo/notice.go
msgid "One-line summary, at most 300 characters"
msgstr "Resumo de uma linha, no máximo 300 caracteres"

#: cmd/bentoo/notice.go
